{
  "name": "erp",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @erp/shared build",
    "db:setup": "bash scripts/db-setup.sh",
    "db:migrate": "pnpm --filter @erp/api migrate",
    "db:seed-demo": "pnpm --filter @erp/api seed:demo",
    "dev:api": "pnpm --filter @erp/api dev",
    "dev:web": "pnpm --filter @erp/web dev",
    "test": "pnpm --filter @erp/shared test && pnpm --filter @erp/api test",
    "typecheck": "pnpm -r typecheck"
  }
}
