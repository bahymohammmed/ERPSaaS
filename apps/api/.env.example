# Application connection (RLS-enforced role)
DATABASE_URL=postgres://erp_app:erp_app_dev@localhost:5432/erp
# Migration connection (schema owner)
MIGRATION_DATABASE_URL=postgres://erp_owner:erp_owner_dev@localhost:5432/erp
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=28800
PORT=4000
CORS_ORIGIN=http://localhost:3000
STORAGE_DIR=./storage
# Chromium used for PDF export; auto-detected when unset
CHROMIUM_PATH=
