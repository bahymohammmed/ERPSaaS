{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "swc",
    "typeCheck": true,
    "tsConfigPath": "tsconfig.build.json",
    "deleteOutDir": true,
    "assets": [{ "include": "db/migrations/*.sql", "watchAssets": true }]
  }
}
