# Copy to .env next to docker-compose.prod.yml and fill in. Never commit .env.
# Generate each secret with:  openssl rand -hex 32
# (PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) }) )
# Use only letters and digits in the database passwords: they are placed inside a URL.

# Database
POSTGRES_PASSWORD=
ERP_OWNER_PASSWORD=
ERP_APP_PASSWORD=

# Application secrets. Never change MFA_ENCRYPTION_KEY once users enable 2FA.
JWT_SECRET=
MFA_ENCRYPTION_KEY=

# Platform administrator (signs in to /platform and creates tenants)
PLATFORM_ADMIN_EMAIL=admin@yourcompany.com
PLATFORM_ADMIN_PASSWORD=

# on = anyone can create an organisation from the sign-up page
PUBLIC_SIGNUP=off

# Optional demo tenant (demo@example.com) for trying the system
SEED_DEMO=false
DEMO_PASSWORD=

# Option A (Caddy): your domain, already pointing at this server's public IP
DOMAIN=erp.yourcompany.com
CLIENT_IP_HEADER=x-real-ip

# Option B (Cloudflare Tunnel): token from Cloudflare Zero Trust → Networks → Tunnels,
# and use the client address Cloudflare provides:
# TUNNEL_TOKEN=
# CLIENT_IP_HEADER=cf-connecting-ip
